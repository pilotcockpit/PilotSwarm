{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ps/history": ["./src/types/ps-history.d.ts"],
      "@ps/state": ["./src/types/ps-state.d.ts"],
      "@ps/sandbox": ["./src/types/ps-sandbox.d.ts"],
      "pilotswarm-sdk/api": ["../sdk/api/index.d.ts"]
    }
  },
  "include": ["src"]
}
